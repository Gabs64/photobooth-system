# Birthday Party Photobooth System - Environment Configuration Template
# Copy these values into your Vercel Project Settings -> Environment Variables

# Server Port
PORT=3000

# Google Drive OAuth Credentials (Required for Cloud Sync & QR Code generation)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Production Redirect URI (Update with your actual Vercel domain when deployed)
GOOGLE_REDIRECT_URI="https://your-vercel-domain.vercel.app/api/cloud/gdrive/callback"

# Admin Portal Security Session Secret
ADMIN_SESSION_SECRET="photobooth_admin_secret_key_2026"

# Optional Amazon S3 Credentials
S3_BUCKET_NAME="photobooth-storage"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
